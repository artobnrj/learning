# Copy to .env and edit. All values are optional; these are the defaults.

# Where the model server listens (any OpenAI-compatible chat API).
LLM_BASE_URL=http://localhost:11434/v1

# Which model to use. Must be downloaded first:  ollama pull qwen3:8b
LLM_MODEL=qwen3:8b

# Local servers ignore this. Hosted services (Groq, OpenRouter, ...) need a real key.
LLM_API_KEY=not-needed

# --- Other setups (uncomment one block) -----------------------------------------
# Smaller/faster model for 8 GB machines:
# LLM_MODEL=qwen3:4b
#
# LM Studio (load a model in the app, then start its local server):
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen/qwen3-8b
#
# llama.cpp server:  llama-server -m model.gguf --jinja --port 8080
# LLM_BASE_URL=http://localhost:8080/v1
